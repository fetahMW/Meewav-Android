<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Meewav" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#09080E</item>
        <item name="android:colorAccent">#9764FF</item>
        <item name="android:statusBarColor">#09080E</item>
        <item name="android:navigationBarColor">#09080E</item>
    </style>
    <style name="Theme.Meewav.Launch" parent="Theme.Meewav">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
